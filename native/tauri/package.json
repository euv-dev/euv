{
  "name": "euv",
  "version": "0.1.2",
  "scripts": {
    "config": "node scripts/config/apply-config.js",
    "bundle:example": "node scripts/build/bundle-example.js",
    "verify:apk": "node scripts/validation/verify-apk.js",
    "prefetch": "node scripts/cache/prefetch-cache.js",
    "icons": "python3 scripts/config/gen-icons.py",
    "test": "node --test scripts/tests/*.test.js",
    "benchmark:prefetch": "node scripts/benchmark/benchmark-prefetch.js",
    "benchmark:startup": "node scripts/benchmark/benchmark-startup.js",
    "build:android": "./scripts/build/build.sh android release",
    "build:android:debug": "./scripts/build/build.sh android debug",
    "build:windows": "node scripts/build/build-client.js windows",
    "build:macos": "node scripts/build/build-client.js macos",
    "build:linux": "node scripts/build/build-client.js linux",
    "build:ios": "node scripts/build/build-client.js ios",
    "build:ios:simulator": "node scripts/build/build-client.js ios-simulator",
    "verify:native": "node scripts/validation/verify-native.js",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2"
  }
}
