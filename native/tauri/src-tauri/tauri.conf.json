{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Euv",
  "version": "0.1.2",
  "identifier": "com.euv",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node scripts/bundle-example.js && node scripts/apply-config.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Euv",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
