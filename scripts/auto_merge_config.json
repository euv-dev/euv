{
 "base_branch": "master",
 "delete_branch": true,
 "merge_method": "squash",
 "post_merge_dispatch": [
  "rust.yml",
  "build-clients.yml",
  "build-apk.yml",
  "mirror.yml"
 ],
 "required_checks": [
  "setup",
  "check",
  "tests",
  "clippy",
  "build",
  "automation"
 ],
 "trusted_authors": [
  "vshengbro"
 ],
 "version_guard": {
  "path": "Cargo.toml",
  "section": "workspace.package",
  "when_files_match": [
   "\\.rs$",
   "^Cargo\\.toml$"
  ]
 }
}